# Coverage settings for scripts/run_tests.py --coverage, which sets COV_ROOT.
[run]
branch = True
parallel = True
data_file = ${COV_ROOT}/coverage/data/.coverage
source = ${COV_ROOT}
omit =
    ${COV_ROOT}/tests/*
    ${COV_ROOT}/scripts/*
    ${COV_ROOT}/coverage/*
    ${COV_ROOT}/data/*
    */__pycache__/*

[report]
show_missing = True
skip_empty = True
precision = 1

[html]
directory = ${COV_ROOT}/coverage/html

# A --coverage run fails below this. Set just under the measured total
# (73.3% on 2026-10-19); raise it as tests are added, never lower it.
[agentalsec]
floor = 73.0
