# AgentalSec Linux secrets. Copy to .env and fill in.
# .env is gitignored; this template is not.
#
# A real environment variable overrides anything set here.

# Model provider API key, for whichever endpoint provider.api_url in
# config.json points at.
AGENTAL_API_KEY=

# The dashboard's own key for /api. Leave it blank to have one made at the
# first start; set it to keep the same key across restarts.
# Make one: python3 -c "import secrets; print(secrets.token_hex(32))"
AGENTAL_APP_API_KEY=

# SSH key for watching other Linux computers (linux_monitor in config.json).
# Make one: ssh-keygen -t ed25519 -C "agental_sec"
# Then: ssh-copy-id -i ~/.ssh/agental_sec.pub user@remote-host
AGENTAL_SSH_KEY_PATH=~/.ssh/agental_sec

# The router's SNMP read community, only for router_monitor in config.json.
# Use a read-only one: SNMP v2c sends it unencrypted.
AGENTAL_ROUTER_COMMUNITY=

# AbuseIPDB, https://www.abuseipdb.com/account/api
# Free, about 1000 checks a day. Says whether an address is known bad.
AGENTAL_ABUSEIPDB_KEY=

# abuse.ch, https://auth.abuse.ch/ (sign in, then your profile)
# Free. Needed for file hash lookups (MalwareBazaar)
# and the Feodo and URLhaus lists. Not used for ThreatFox, which needs no key.
AGENTAL_ABUSECH_KEY=

# AlienVault OTX, free from otx.alienvault.com (Settings, API key).
# Without it the OTX threat list is not downloaded.
AGENTAL_OTX_KEY=

# GreyNoise, https://www.greynoise.io
# Says whether an address scans the whole internet or just you. The free
# key needs a business email address.
AGENTAL_GREYNOISE_KEY=

# ipapi.is, https://ipapi.is, free, 1000 checks a day.
# Says whether an address is a VPN, proxy, Tor, datacentre or mobile network.
AGENTAL_IPAPI_KEY=

# NVD (NIST) key, https://nvd.nist.gov/developers/request-an-api-key
# Optional. Raises the rate limit for CVE and CVSS lookups.
AGENTAL_NVD_API_KEY=

# Web search for the analyst. Optional, any one of these is enough.
# Tavily, https://tavily.com
AGENTAL_TAVILY_KEY=
# SerpAPI, https://serpapi.com
AGENTAL_SERPAPI_KEY=
# Google Programmable Search, key and search engine id
AGENTAL_GOOGLE_CSE_KEY=
AGENTAL_GOOGLE_CSE_CX=
