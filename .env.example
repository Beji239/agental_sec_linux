# AgentalSec Linux secrets. Copy to .env and fill in.
# .env is gitignored; this template is not.
#
# A real environment variable overrides anything set here.

# Model provider API key, for whichever endpoint provider.api_url in
# config.json points at.
AGENTAL_API_KEY=

# AgentalSec's own REST API key, used by the dashboard to authenticate
# against /api/*. Any 64-char hex string. Generated automatically on first
# run if left blank, but it will change on every restart until you set it.
#
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AGENTAL_APP_API_KEY=

# SSH key for remote Linux monitoring (optional)
# Only needed if linux_monitor.enabled = true in config.json
# Point to your private key file; the monitor uses it to SSH into remote
# Linux hosts and read their logs, processes, and autoruns.
#
# Generate: ssh-keygen -t ed25519 -C "agental_sec"
# Then copy the public key to remote hosts: ssh-copy-id -i ~/.ssh/agental_sec.pub user@remote-host
AGENTAL_SSH_KEY_PATH=~/.ssh/agental_sec

# Router SNMP READ community string. Only needed if you turn on
# router_monitor in config.json. Leave it blank and that collector stays off
# and says why, rather than guessing at a default and probing a router you
# never pointed it at.
#
# Use a read-only community. AgentalSec implements no SNMP write operation at
# all, but v2c sends this in clear text on the wire, so a community that can
# also write is a credential worth stealing.
AGENTAL_ROUTER_COMMUNITY=

# AbuseIPDB key -- https://www.abuseipdb.com/account/api
# Free account, roughly 1000 checks a day. This is the one that answers
# "is this address known bad", which nothing else in the keyless set does.
# Leave it blank and the enrichment engine reports abuseipdb as off, with the
# reason, rather than quietly having no reputation source.
AGENTAL_ABUSEIPDB_KEY=

# abuse.ch Auth-Key -- https://auth.abuse.ch/ then your profile
# Free, sign in with an existing Google/Github/LinkedIn/X account. Covers
# MalwareBazaar (file hashes) and URLhaus (malware distribution URLs). Used to
# be open with no key at all; that changed on their side, not ours, which is
# why file hashes currently have no source.
#
# This key feeds tools/feed_matcher.py's Feodo and URLhaus lists. Those send
# it as an Auth-Key header and report a refusal as a reason rather than as an
# empty list, because a feed that is refusing us must not look like a feed
# that is clean.
#
# NOT THREATFOX, since 2026-09-27. ThreatFox's plaintext CSV export
# (threatfox.abuse.ch/export/csv/recent/) answers HTTP 200 with no key at all,
# MEASURED on this host, so it is declared keyless now and this credential is
# not sent to it. Before that it was declared keyed, and on a host without the
# variable the feed reported "no key set" and stopped refreshing while the
# list it needed was downloadable the whole time.
AGENTAL_ABUSECH_KEY=

# AlienVault OTX key -- https://otx.alienvault.com then Settings -> API key
# Free account. THIS IS A DIFFERENT KEY FROM THE ONE ABOVE and it is not
# interchangeable: MEASURED, every OTX bulk endpoint (/pulses/subscribed,
# /pulses/activity, a pulse's indicator list) answers HTTP 403 "Authentication
# required" without it. Only the per-indicator lookup works keyless, which is
# a lookup rather than a feed.
#
# Leave it blank and the OTX feed reports that fact by name, with this
# variable in the sentence, while the other four feeds keep working. The
# individual public pulse object is readable keyless, which is how this
# project's parser was written against a real response rather than a guess.
AGENTAL_OTX_KEY=

# GreyNoise key -- https://www.greynoise.io
# Answers whether an address is mass-scanning the whole internet rather than
# targeting this host, which is the difference between background noise and
# somebody looking at you. Currently OFF and likely to stay off here: the
# unauthenticated tier is 10 lookups a day, and a free key needs a business
# email address, so signing up cannot fix it.
AGENTAL_GREYNOISE_KEY=

# NVD (NIST) key, https://nvd.nist.gov/developers/request-an-api-key
# Optional. Raises the rate limit for CVE and CVSS lookups.
AGENTAL_NVD_API_KEY=

# Web search for the analyst. Optional, any one of these is enough.
# Tavily, https://tavily.com
AGENTAL_TAVILY_KEY=
# SerpAPI, https://serpapi.com
AGENTAL_SERPAPI_KEY=
# Google Programmable Search, key and search engine id
AGENTAL_GOOGLE_CSE_KEY=
AGENTAL_GOOGLE_CSE_CX=
